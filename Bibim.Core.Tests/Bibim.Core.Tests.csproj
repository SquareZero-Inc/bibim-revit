    <Compile Include="..\Bibim.Core\Services\Prompts\PlannerSchema.cs" Link="Linked\PlannerSchema.cs" />
    <Compile Include="..\Bibim.Core\Common\SecretProtector.cs" Link="Linked\SecretProtector.cs" />
    <Compile Include="..\Bibim.Core\Common\LlmErrorPresenter.cs" Link="Linked\LlmErrorPresenter.cs" />
    <Compile Include="..\Bibim.Core\Models\CodeLibraryModels.cs" Link="Linked\CodeLibraryModels.cs" />
    <Compile Include="..\Bibim.Core\Services\CodeLibrarySearch.cs" Link="Linked\CodeLibrarySearch.cs" />
